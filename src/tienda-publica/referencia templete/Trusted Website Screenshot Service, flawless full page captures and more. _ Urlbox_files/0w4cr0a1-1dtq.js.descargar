ousands of companies use Whimsical to collaborate on ideas faster. It is the unified workspace for thinking and collaboration.",language:"Clojure",lead_quote:"Urlbox's support of emojis was a big signal that it could replace our own service. It was a simple replacement - a real success story for us.",location:"Riga, Latvia",logo_svg:function SvgWhimsical(props){return __TURBOPACK__imported__module__191788__.createElement("svg",_extends7({xmlns:"http://www.w3.org/2000/svg",viewBox:"0 0 190.81 39.58"},props),_defs1||(_defs1=__TURBOPACK__imported__module__191788__.createElement("defs",null,__TURBOPACK__imported__module__191788__.createElement("style",null,".cls-1{fill:#fff;}.cls-2{fill:#fff;}.cls-3{fill:#fff;}.cls-4{fill:none;}"))),_path5||(_path5=__TURBOPACK__imported__module__191788__.createElement("path",{className:"cls-1",d:"M24.67,86.07a1.51,1.51,0,0,1,2,.06c1.44,1.43,2.86,2.87,4.3,4.29l-2.15,2.15-2.66-2.65a.75.75,0,0,0-1.12,0q-4.74,4.72-9.47,9.47a.76.76,0,0,0,0,1.16q4.5,4.52,9,9a4.39,4.39,0,0,0,.78.71.78.78,0,0,0,.89-.24l2.61-2.62L31,109.56l-3.95,4a2.4,2.4,0,0,1-.94.7,1.54,1.54,0,0,1-1.6-.42q-6.37-6.36-12.74-12.73a1.54,1.54,0,0,1,.05-2.19c4.28-4.26,8.54-8.55,12.83-12.81Z",transform:"translate(-4.59 -80.21)"})),_path22||(_path22=__TURBOPACK__imported__module__191788__.createElement("path",{className:"cls-2",d:"M35.31,86.14a1.53,1.53,0,0,1,2.21.07L50.19,98.88a1.53,1.53,0,0,1,.41,1.59,2.83,2.83,0,0,1-.81,1L37.86,113.44a2.67,2.67,0,0,1-1,.78,1.53,1.53,0,0,1-1.59-.41L31,109.56l-2.15-2.14-6.35-6.36a1.52,1.52,0,0,1,0-2.17l6.32-6.32L31,90.42c1.43-1.42,2.85-2.86,4.29-4.28Z",transform:"translate(-4.59 -80.21)"})),_path32||(_path32=__TURBOPACK__imported__module__191788__.createElement("path",{className:"cls-3",d:"M56.5,89.74a1.84,1.84,0,0,1,3.06-.08A4,4,0,0,1,60,90.77l2.88,11.66a14.85,14.85,0,0,0,.4,1.49l3.66-13.28A2.32,2.32,0,0,1,68,89.05a1.8,1.8,0,0,1,1.9.25,2.46,2.46,0,0,1,.65,1.1c1.3,4.5,2.52,9,3.86,13.53q1.62-6.65,3.23-13.31a2.42,2.42,0,0,1,.7-1.36,1.85,1.85,0,0,1,2.76