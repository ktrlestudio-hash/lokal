,__TURBOPACK__imported__module__391398__.jsx)(__TURBOPACK__imported__module__226722__.ShieldCheckIcon,{className:"h-7 shrink-0 fill-current text-teal-600"}),(0,__TURBOPACK__imported__module__391398__.jsxs)("div",{className:"space-y-2",children:[(0,__TURBOPACK__imported__module__391398__.jsx)("h3",{className:"text-lg font-semibold text-slate-800",children:"Vulnerability & Pen Testing"}),(0,__TURBOPACK__imported__module__391398__.jsxs)("p",{className:"text-sm sm:text-base",children:["We run regular automated scans of our product using AppCheck to help us identify potential vulnerabilities. We also make reporting a vulnerability easy for those who find them, with a dedicated mailbox:"," ",(0,__TURBOPACK__imported__module__391398__.jsx)("a",{className:"text-indigo-500",href:"mailto:support@urlbox.com",children:"support@urlbox.com"}),". Our security policy for ethical hackers, security researchers and vulnerability hunters is"," ",(0,__TURBOPACK__imported__module__391398__.jsx)(__TURBOPACK__imported__module__41158__.default,{className:"text-indigo-500",href:"https://docs.google.com/document/d/1UPixSShO3QRbtnkCmLM28Sl5XMmCrW8vxvePdSJxqsY",children:"available here"}),"."]})]})]}),(0,__TURBOPACK__imported__module__391398__.jsx)(__TURBOPACK__imported__module__807585__.IconSection,{className:"max-w-lg",icon:{component:ArchiveIcon,position:"top",color:"text-teal-600"},heading:"Backups & Data Retention",text:"We run point-in-time style backups, allowing us to rollback data to any point over the past few days. We also perform snapshot style backups on a nightly basis, again stored for about a week. Screenshots are cached for 30 days by default when not using your own storage infrastructure."}),(0,__TURBOPACK__imported__module__391398__.jsx)(__TURBOPACK__imported__module__807585__.IconSection,{className:"max-w-lg",icon:{component:__TURBOPACK__imported__module__30645__.ServerIcon,position:"top",color:"text-teal-600"},heading:"Hosting",text:"We use a combination of cloud providers 