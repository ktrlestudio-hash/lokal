                    <head>
                      <meta charset="utf-8">
                      <title>Invoice</title>
                      <link rel="stylesheet" href="style.css">
                      <link rel="license" href="https://www.opensource.org/licenses/mit-license/">
                      <script src="script.js"></script>
                    </head>
                    <body>
                      <header>
                        <h1>Invoice</h1>
                        <address contenteditable>
                          <p>Jonathan Neal</p>
                          <p>101 E. Chapman Ave<br>Orange, CA 92866</p>
                          <p>(800) 555-1234</p>
                        </address>
                        <span><img alt="" src="http://www.jonathantneal.com/examples/invoice/logo.png"><input type="file" accept="image/*"></span>
                      </header>
                      <article>
                        <h1>Recipient</h1>
                        <address contenteditable>
                          <p>Some Company<br>c/o Some Guy</p>
                        </address>
                        <table class="meta">
                          <tr>
                            <th><span contenteditable>Invoice #</span></th>
                            <td><span contenteditable>101138</span></td>
                          </tr>
                          <tr>
                            <th><span contenteditable>Date</span></th>
                            <td><span contenteditable>January 1, 2012</span></td>
                          </tr>
                          <tr>
                            <th><span contenteditable>Amount Due</span></th>
                            <td><span id="prefix" contenteditable>$</span><span>600.00</span></td>
                          </tr>
                        </table>
                        <table class="inventory">
                          <thead>
                            <tr>
                              <th><span contenteditable>Item</span></th>
                              <th><span contenteditable>Description</span></th>
                              <th><span contenteditable>Rate</span></th>
                              <th><span contenteditable>Quantity</span></th>
                              <th><span contenteditable>Price</span></th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr>
                              <td><a class="cut">-</a><span contenteditable>Front End Consultation</span></td>
                              <td><span contenteditable>Experience Review</span></td>
                              <td><span data-prefix>$</span><span contenteditable>150.00</span></td>
                              <td><span contenteditable>4</span></td>
                              <td><span data-prefix>$</span><span>600.00</span></td>
                            </tr>
                          </tbody>
                        </table>
                        <a class="add">+</a>
                        <table class="balance">
                          <tr>
                            <th><span contenteditable>Total</span></th>
                            <td><span data-prefix>$</span><span>600.00</span></td>
                          </tr>
                          <tr>
                            <th><span contenteditable>Amount Paid</span></th>
                            <td><span data-prefix>$</span><span contenteditable>0.00</span></td>
                          </tr>
                          <tr>
                            <th><span contenteditable>Balance Due</span></th>
                            <td><span data-prefix>$</span><span>600.00</span></td>
                          </tr>
                        </table>
                      </article>
                      <aside>
                        <h1><span contenteditable>Additional Notes</span></h1>
                        <div contenteditable>
                          <p>A finance charge of 1.5% will be made on unpaid balances after 30 days.</p>
                        </div>
                      </aside>
                    </body>
                  </html>`,css:`/* reset */

                  *
                  {
                    border: 0;
                    box-sizing: content-box;
                    color: inherit;
                    font-family: inherit;
                    font-size: inherit;
                    font-style: inherit;
                    font-weight: inherit;
                    line-height: inherit;
                    list-style: none;
                    margin: 0;
                    padding: 0;
                    text-decoration: none;
                    vertical-align: top;
                  }

                  /* content editable */

                  *[contenteditable] { border-radius: 0.25em; min-width: 1em; outline: 0; }

                  *[contenteditable] { cursor: pointer; }

                  *[contenteditable]:hover, *[contenteditable]:focus, td:hover *[contenteditable], td:focus *[contenteditable], img.hover { background: #DEF; box-shadow: 0 0 1em 0.5em #DEF; }

                  span[contenteditable] { display: inline-block; }

                  /* heading */

                  h1 { font: bold 100% sans-serif; letter-spacing: 0.5em; text-align: center; text-transform: uppercase; }

                  /* table */

                  table { font-size: 75%; table-layout: fixed; width: 100%; }
                  table { border-collapse: separate; border-spacing: 2px; }
                  th, td { border-width: 1px; padding: 0.5em; position: relative; text-align: left; }
                  th, td { border-radius: 0.25em; border-style: solid; }
                  th { background: #EEE; border-color: #BBB; }
                  td { border-color: #DDD; }

                  /* page */

                  html { font: 16px/1 'Open Sans', sans-serif; overflow: auto; padding: 0.5in; }
                  html { background: #999; cursor: default; }

                  body { box-sizing: border-box; height: 11in; margin: 0 auto; overflow: hidden; padding: 0.5in; width: 8.5in; }
                  body { background: #FFF; border-radius: 1px; box-shadow: 0 0 1in -0.25in rgba(0, 0, 0, 0.5); }

                  /* header */

                  header { margin: 0 0 3em; }
                  header:after { clear: both; content: ""; display: table; }

                  header h1 { background: #000; border-radius: 0.25em; color: #FFF; margin: 0 0 1em; padding: 0.5em 0; }
                  header address { float: left; font-size: 75%; font-style: normal; line-height: 1.25; margin: 0 1em 1em 0; }
                  header address p { margin: 0 0 0.25em; }
                  header span, header img { display: block; float: right; }
                  header span { margin: 0 0 1em 1em; max-height: 25%; max-width: 60%; position: relative; }
                  header img { max-height: 100%; max-width: 100%; }
                  header input { cursor: pointer; -ms-filter:"progid:DXImageTransform.Microsoft.Alpha(Opacity=0)"; height: 100%; left: 0; opacity: 0; position: absolute; top: 0; width: 100%; }

                  /* article */

                  article, article address, table.meta, table.inventory { margin: 0 0 3em; }
                  article:after { clear: both; content: ""; display: table; }
                  article h1 { clip: rect(0 0 0 0); position: absolute; }

                  article address { float: left; font-size: 125%; font-weight: bold; }

                  /* table meta & balance */

                  table.meta, table.balance { float: right; width: 36%; }
                  table.meta:after, table.balance:after { clear: both; content: ""; display: table; }

                  /* table meta */

                  table.meta th { width: 40%; }
                  table.meta td { width: 60%; }

                  /* table items */

                  table.inventory { clear: both; width: 100%; }
                  table.inventory th { font-weight: bold; text-align: center; }

                  table.inventory td:nth-child(1) { width: 26%; }
                  table.inventory td:nth-child(2) { width: 38%; }
                  table.inventory td:nth-child(3) { text-align: right; width: 12%; }
                  table.inventory td:nth-child(4) { text-align: right; width: 12%; }
                  table.inventory td:nth-child(5) { text-align: right; width: 12%; }

                  /* table balance */

                  table.balance th, table.balance td { width: 50%; }
                  table.balance td { text-align: right; }

                  /* aside */

                  aside h1 { border: none; border-width: 0 0 1px; margin: 0 0 1em; }
                  aside h1 { border-color: #999; border-bottom-style: solid; }

                  /* javascript */

                  .add, .cut
                  {
                    border-width: 1px;
                    display: block;
                    font-size: .8rem;
                    padding: 0.25em 0.5em;
                    float: left;
                    text-align: center;
                    width: 0.6em;
                  }

                  .add, .cut
                  {
                    background: #9AF;
                    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
                    background-image: -moz-linear-gradient(#00ADEE 5%, #0078A5 100%);
                    background-image: -webkit-linear-gradient(#00ADEE 5%, #0078A5 100%);
                    border-radius: 0.5em;
                    border-color: #0076A3;
                    color: #FFF;
                    cursor: pointer;
                    font-weight: bold;
                    text-shadow: 0 -1px 2px rgba(0,0,0,0.333);
                  }

                  .add { margin: -2.5em 0 0; }

                  .add:hover { background: #00ADEE; }

                  .cut { opacity: 0; position: absolute; top: 0; left: -1.5em; }
                  .cut { -webkit-transition: opacity 100ms ease-in; }

                  tr:hover .cut { opacity: 1; }

                  @media print {
                    * { -webkit-print-color-adjust: exact; }
                    html { background: none; padding: 0; }
                    body { box-shadow: none; margin: 0; }
                    span:empty { display: none; }
                    .add, .cut { display: none; }
                  }

                  @page { margin: 0; }`,format:"pdf"}},{title:"Screenshot Gallery in HTML",options:{retina:!0,html:`<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Website Screenshots</title>

    <!-- Include Tailwind CSS from CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        /* Adding a bit of transition to make the rotation smooth */
        .tilt {
            transition: transform 0.3s ease-in-out;
        }
    </style>
</head>
<body class="bg-gray-100 font-sans">

    <div class="max-w-5xl mx-auto py-10">
        <h1 class="text-4xl font-bold text-center mb-8">Website Screenshots</h1>
        <p class="text-center text-gray-700 mb-8">Explore screenshots of popular websites using the <a href="https://screenshotof.com" class="text-blue-600 hover:underline">screenshotof.com</a> API.</p>
        
        <!-- Container to append dynamic content -->
        <div id="dynamic-content" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </div>

    <!-- JavaScript to dynamically create DOM nodes with random tilt -->
    <script>
        // Example data array with popular website URLs
        const exampleDataArray = [
            { name: 'Apple', url: 'apple.com' },
            { name: 'Stripe', url: 'stripe.com' },
            { name: 'Urlbox', url: 'urlbox.com' }
        ];

        // Function to generate a random tilt angle between -5 and 5 degrees
        function getRandomTilt() {
            return Math.floor(Math.random() * 10 - 5); // Random angle between -5 and 5 degrees
        }

        // Function to create and append dynamic content
        function createDynamicContent() {
            const contentContainer = document.getElementById('dynamic-content');
            
            exampleDataArray.forEach(item => {
                // Create a card container div
                const cardDiv = document.createElement('div');
                cardDiv.classList.add('bg-white', 'p-6', 'rounded-lg', 'shadow-lg', 'hover:shadow-xl', 'transition-shadow', 'duration-300', 'tilt');
                
                // Apply a random rotation to the card
                const randomTilt = getRandomTilt();
                cardDiv.style.transform = \`rotate(\${randomTilt}deg)\`;
                
                // Create and append website name
                const websiteName = document.createElement('h2');
                websiteName.textContent = item.name;
                websiteName.classList.add('text-xl', 'font-semibold', 'mb-4', 'text-center');
                cardDiv.appendChild(websiteName);
                
                // Create and append screenshot image
                const screenshotImg = document.createElement('img');
                screenshotImg.src = \`https://screenshotof.com/\${item.url}?s=512\`;
                screenshotImg.alt = \`Screenshot of \${item.name}\`;
                screenshotImg.classList.add('w-full', 'h-auto', 'rounded-md', 'mb-4');
                cardDiv.appendChild(screenshotImg);

                // Create and append website link
                const websiteLink = document.createElement('a');
                websiteLink.href = \`https://\${item.url}\`;
                websiteLink.textContent = \`Visit \${item.name}\`;
                websiteLink.classList.add('block', 'text-center', 'text-blue-600', 'hover:underline', 'font-medium');
                cardDiv.appendChild(websiteLink);

                // Append the card to the content container
                contentContainer.appendChild(cardDiv);
            });
        }

        // Call the function to create and append the content
        createDynamicContent();
    </script>

</body>
</html>`}}]},{name:"format",label:"Output Format",type:"enum",desc:"The output format of the resulting render.",enums:["png","jpeg","webp","avif","svg","pdf","html","mp4","webm","md"],defaultOptions:{url:"example.com"},examples:[{title:"PNG Image",options:{}},{title:"JPEG Image",options:{format:"jpeg"}},{title:"PDF",options:{format:"pdf"}},{title:"SVG",options:{format:"svg"}},{title:"Markdown",options:{format:"md"}},{title:"HTML",options:{format:"html"}},{title:"MP4",options:{format:"mp4"}}]},{name:"width",label:"Viewport Width",type:"number",defaultVal:1280,desc:"The viewport width of the browser, in pixels.",defaultOptions:{url:"apple.com"},examples:[{title:"Emulate mobile viewport",options:{width:375}},{title:"Emulate tablet viewport",options:{width:768}},{title:"Emulate desktop viewport",options:{width:1280}},{title:"Emulate wide monitor viewport",options:{width:2e3}}]},{name:"height",label:"Viewport Height",type:"number",defaultVal:1024,desc:"The viewport height of the browser, in pixels.",defaultOptions:{url:"apple.com"},examples:[{title:"Emulate Iphone 14 Pro Max Viewport Height",options:{height:932}},{title:"Emulate Ipad Pro 12.9 Inch Pro Viewport Height",options:{height:1366}},{title:"Emulate Macbook Pro 16 Inch Viewport Height",options:{height:960}},{title:"Emulate Common Desktop Screen Viewport Height",options:{height:1080}}]},{name:"full_page",type:"boolean",defaultVal:"false",desc:"Specify whether to capture the full scrollable area of the website.\n                For PDFs, `full_page` mode will attempt to capture the whole website onto one single page PDF document.\n                It's likely you'll want to also hide any cookie banners that crop up during a full page screenshot, so we recommend you use [`click_accept`](#click_accept) and [`hide_cookie_banners`](#hide_cookie_banners) too.",defaultOptions:{url:"urlbox.com"},examples:[{title:"Full page screenshot of urlbox.com",options:{full_page:!0}},{title:"Full page PDF of urlbox.com",options:{full_page:!0,format:"pdf",pdf_auto_crop:!0}}]},{name:"selector",type:"string",desc:"Take a screenshot of the element that matches this selector. By default, if the selector is not found, Urlbox will take a normal viewport screenshot. If you prefer Urlbox to fail the request when the selector is not found, pass `fail_if_selector_missing=true`.",defaultOptions:{url:"github.com"},examples:[{title:"Select only the Github logo",options:{selector:".octicon-mark-github"}},{title:"Snapshotting terms and conditions",options:{url:"https://urlbox.com/policies/terms",selector:"section"}}]},{name:"clip",type:"string",desc:"Clip the screenshot to the bounding box specified by `x,y,width,height`.",defaultOptions:{url:"urlbox.com"},examples:["0,0,400,400","100,100,200,200","0,800,800,600"]},{name:"gpu",plan:"ultra",type:"boolean",defaultVal:"false",desc:"Enable GPU acceleration to render 3D scenes and heavy WebGL content. This is a beta feature and requires pre-approval. Please contact support@urlbox.com to enable this feature on your account.",defaultOptions:{gpu:!0},examples:[{title:"WebGL water",options:{url:"https://madebyevan.com/webgl-water/",wait_for:"canvas"}},{title:"WebGL Earth",options:{url:"https://jsulpis.github.io/realtime-planet-shader/earth/",wait_for:"canvas.loaded"}},{title:"LLM 3D Visualisation",options:{url:"https://bbycroft.net/llm"}}]},{name:"response_type",type:"enum",enums:["json","binary"],desc:"For render link requests, setting this option to `json` will change the response type of the Urlbox request to JSON. For the API, the default response type is JSON.",defaultOptions:{url:"example.com"},examples:["json","binary"]},{name:"secure_mode",type:"boolean",plan:"ultra",desc:"Ensure that sensitive data remains protected throughout the process. In addition to this option, you need to use one of the storage approaches described on our [`blog post`]( /secure-screenshots ) about secure mode."}]},{desc:"Options for blocking or dismissing certain page elements, such as cookie banners.",heading:"Blocking Options",options:[{name:"block_ads",type:"boolean",desc:"Blocks requests from popular advertising networks from loading.",defaultOptions:{url:"nytimes.com"},examples:[{title:"With ads blocked",options:{block_ads:!0}},{title:"Without ads blocked",options:{block_ads:!1}}]},{name:"hide_cookie_banners",type:"boolean",desc:"Automatically hides cookie banners from most websites, by setting their style to `display: none !important;`",defaultOptions:{url:"vectary.com"},examples:[{title:"With cookie banners hidden",options:{hide_cookie_banners:!0}},{title:"Without cookie banners hidden",options:{}}]},{name:"click_accept",type:"boolean",desc:"Similar to the [`hide_cookie_banners`](#hide_cookie_banners) option, but instead of hiding the banners, this option attempts to click on the 'Accept' button, in order to accept cookies.",defaultOptions:{url:"vectary.com"},examples:[{title:"With click_accept",options:{click_accept:!0}},{title:"Without click_accept",options:{}}]},{name:"press_escape",type:"boolean",desc:"Attempts to press the Escape (ESC) key before capturing the page. Useful for dismissing pop-ups, overlays, or advertising banners that appear on load."},{name:"block_urls",type:"string[]",desc:"Block requests from specific domains from loading. You can use wildcard characters such as `*` to match subdomains.",examples:[{title:"Blocking chat plugin from Urlbox",options:{url:"urlbox.com",block_urls:["*crisp*"]}},{title:"Without blocking chat plugin from Urlbox",options:{url:"urlbox.com",delay:2e3,click_accept:!0}}]},{name:"block_images",type:"boolean",desc:"Blocks image requests",defaultOptions:{url:"https://unsplash.com/"},examples:[{title:"Blocking all images from Unsplash",options:{click_accept:!0,block_images:!0}}]},{name:"block_fonts",type:"boolean",desc:"Blocks font requests",defaultOptions:{url:"urlbox.com"},examples:[{title:"Blocking all font downloads from Urlbox",options:{block_fonts:!0}},{title:"Without blocking font downloads from Urlbox",options:{}}]},{name:"block_medias",type:"boolean",desc:"Block video and audio requests",examples:[{title:"Blocking video and audio requests from Vimeo",options:{block_medias:!0,format:"mp4",url:"https://vimeo.com/"}},{title:"Without blocking video and audio requests from Vimeo",options:{url:"https://vimeo.com/",format:"mp4"}}]},{name:"block_styles",type:"boolean",desc:"Prevent stylesheet requests from loading",defaultOptions:{url:"https://news.ycombinator.com/"},examples:[{title:"Blocking stylesheets",options:{block_styles:!0}},{title:"Without blocking stylesheets",options:{}}]},{name:"block_scripts",type:"boolean",desc:"Prevent requests for javascript scripts from loading",defaultOptions:{url:"https://www.apple.com/uk/iphone-16-pro/",format:"mp4"},examples:[{title:"Blocking scripts",options:{block_scripts:!0}},{title:"Without blocking scripts",options:{}}]},{name:"block_frames",type:"boolean",desc:"Prevents iframe and frame content from loading by blocking non-navigation document requests. The main page will load normally, but any embedded frames/iframes will be blocked.",defaultOptions:{url:"https://www.nytimes.com"},examples:[{title:"Blocking frames",options:{block_frames:!0}}]},{name:"block_fetch",desc:"Block fetch requests from the target URL.",type:"boolean"},{name:"block_xhr",type:"boolean",desc:"Block XHR requests from the target URL.",defaultOptions:{url:"https://www.gumtree.com/"},examples:[{title:"Blocking XHR",options:{block_xhr:!0}}]},{name:"block_sockets",desc:"Prevents WebSocket connections from being established, blocking real-time communication features like live chat, notifications, or dynamic updates.",type:"boolean"},{name:"block_data_urls",desc:"Block data URLs such as `data:image/png;base64,...`",type:"boolean"},{name:"hide_selector",desc:'Hide specific HTML elements on the page before rendering. This option accepts a comma-delimited string of CSS element selectors that will be hidden by setting their style to `visibility: hidden !important; pointer-events: none !important;`. This preserves the page layout while making elements invisible.\n\nThis is particularly useful for:\n- Hiding pop-ups, banners, or cookie notices\n- Removing advertisements or promotional overlays\n- Excluding navigation menus or sidebars\n- Hiding specific content sections\n\n**Selector types supported:**\n- **Element selectors** (e.g., `h1`, `div`, `img`) - Hide all elements of that type\n- **Class selectors** (e.g., `.popup`, `.banner`) - Hide elements with specific CSS classes\n- **ID selectors** (e.g., `#header`, `#sidebar`) - Hide elements with specific IDs\n- **Complex selectors** (e.g., `.nav ul li`, `div.content > p`) - Use any valid CSS selector\n- **Multiple selectors** - Combine multiple selectors with commas\n\n**Tip:** To find the selector for any element, open your browser\'s DevTools, right-click the element in the Elements tab, and select "Copy > Copy selector".',type:"string",defaultOptions:{url:"urlbox.com"},examples:[{title:"Hiding an h1 element",options:{hide_selector:"h1"}},{title:"Without hiding any elements",options:{}}]}]},{desc:"Customize the look of the page before rendering a screenshot",heading:"Customize Options",options:[{name:"js",plan:"ultra",type:"string",desc:"Execute custom JavaScript in the context of the page. The JS gets executed after the page's dom has loaded, but before the screenshot is taken. No need to use `load` etc event handlers to run code, as these events will already have fired by the time this JS gets executed. You can use `await` to wait for promises to resolve.",defaultOptions:{url:"urlbox.com"},examples:[{title:"Inject a timestamp of the screenshot into the screenshot",options:{js:`var now = new Date();
                      var dateTimeDiv = document.createElement("div");
                      dateTimeDiv.innerText = now.toLocaleString();
                      dateTimeDiv.style.cssText = "position: absolute; top: 10px; right: 10px; padding: 10px; background-color: lightgray; border: 2px solid black; font-weight:semibold; font-family: Arial, sans-serif; font-size: 24px; z-index: 1000;";
                      document.body.appendChild(dateTimeDiv);`}},{title:"Overriding a headline",options:{js:'document.querySelector("h1").textContent = "I just overrode the headline, oops!!";'}}]},{name:"css",type:"string",desc:"Inject custom CSS into the page",defaultOptions:{url:"urlbox.com"},examples:[{title:"Highlight elements with a red border",options:{css:"a {border: 4px solid red !important; padding: 4px;}"}},{title:"Changing background colour",options:{css:"header,main, main > section > div {background-color: cyan !important;}"}}]},{name:"dark_mode",type:"boolean",defaultVal:"false",defaultOptions:{url:"urlbox.com/docs/api"},examples:[!0,!1],desc:"Emulate dark mode on websites by setting `prefers-color-scheme: dark`"},{defaultOptions:{url:"https://webkit.org/blog-files/prefers-reduced-motion/prm.htm",format:"mp4"},name:"reduced_motion",type:"boolean",desc:"Prefer less animations on websites by setting `prefers-reduced-motion: reduced`",examples:[{title:"With reduced motion",options:{reduced_motion:!0}},{title:"Without reduced motion",options:{}}]},{name:"show_timestamp",type:"boolean",desc:"Shows a timestamp in a header above the rendered screenshot. Can be paired with show URL. If you're rendering a PDF, you can achieve this with the show_header option.",defaultOptions:{url:"https://example.com",format:"png"},examples:[{title:"With a timestamp",options:{show_timestamp:!0}},{title:"Without a timestamp",options:{}}]},{name:"show_url",type:"boolean",desc:"Shows a URL in a header above the rendered screenshot. Can be paired with show timestamp. If you're rendering a PDF, you can achieve this with the show_header option.",defaultOptions:{url:"https://example.com",format:"png"},examples:[{title:"With a URL",options:{show_url:!0}},{title:"With a timestamp and URL",options:{show_timestamp:!0,show_url:!0}},{title:"Without a URL",options:{}}]}]},{desc:"Options relating to the generated screenshot image",heading:"Screenshot Options",options:[{name:"retina",type:"boolean",defaultVal:"false",desc:"Take a 'retina' or high-definition screenshot, equivalent to setting a device pixel ratio of 2.0 or @2x. Please note that retina screenshots will be double the normal dimensions and will normally take slightly longer to process due to the much bigger image size.",defaultOptions:{url:"urlbox.com"},examples:[!0,!1]},{name:"thumb_width",type:"number",desc:"The width of the generated thumbnail, in pixels. Omit for a full-size screenshot.",defaultOptions:{url:"example.com"},examples:[100,200,400]},{name:"thumb_height",type:"number",desc:"The height of the generated thumbnail, in pixels. Omit for a full-size screenshot.",defaultOptions:{url:"example.com"},examples:[100,200,400]},{name:"img_fit",type:"enum",desc:"How the screenshot should be resized or cropped to fit the dimensions when using [`thumb_width`](#thumb_width) and/or [`thumb_height`](#thumb_height) options",enums:[{name:"cover",desc:"Preserving aspect ratio, attempt to ensure the image covers both `thumb_width` and/or `thumb_height` by cropping/clipping to fit."},{name:"contain",desc:"Preserving aspect ratio, contain within both `thumb_width` and/or `thumb_height` using letterboxing where necessary."},{name:"fill",desc:"Ignore the aspect ratio and stretch to both `thumb_width` and/or `thumb_height`."},{name:"inside",desc:"Preserving aspect ratio, resize the image to be as large as possible while ensuring its dimensions are less than or equal to `thumb_width` and/or `thumb_height`."},{name:"outside",desc:"Preserving aspect ratio, resize the image to be as small as possible while ensuring its dimensions are greater than or equal to `thumb_width` and/or `thumb_height`."}],defaultVal:"cover",defaultOptions:{url:"urlbox.com",thumb_width:400,thumb_height:400},examples:["cover","contain","fill","inside","outside"]},{name:"img_position",type:"enum",desc:"How the image should be positioned when using an [`img_fit`](#img_fit) of `cover` or `contain`.",defaultVal:"center",enums:["north","northeast","east","southeast","south","southwest","west","northwest","center","centre"],defaultOptions:{url:"urlbox.com",thumb_width:400,thumb_height:400},examples:["north","south","west","east","center","northwest",{options:{img_fit:"contain",img_position:"north"},title:"img_fit=contain, img_position=north"},{options:{img_fit:"contain",img_position:"south"},title:"img_fit=contain, img_position=south"},{options:{img_fit:"contain",img_position:"west"},title:"img_fit=contain, img_position=west"},{options:{img_fit:"contain",img_position:"east"},title:"img_fit=contain, img_position=east"},{options:{img_fit:"contain",img_position:"center"},title:"img_fit=contain, img_position=center"},{options:{img_fit:"contain",img_position:"northwest"},title:"img_fit=contain, img_position=northwest"}]},{name:"img_bg",desc:"Background colour to use when [img_fit](#img_fit) is `contain`, or [`img_pad`](#img_pad) is used, defaults to black without transparency",type:"string",defaultOptions:{url:"urlbox.com",thumb_width:400,thumb_height:400,img_fit:"contain"},examples:["red","#ccc","rgb(180, 255, 200)","rgba(180, 255, 200, 0.4)","hsl(60, 20%, 20%)"]},{name:"img_pad",type:"string",desc:"Pad the screenshot, giving it a border. Can either be a single pixel value that gets added to each side, or a comma delimited string of `top,right,bottom,left` pixel values.",defaultOptions:{url:"urlbox.com",thumb_width:400,thumb_height:400,img_bg:"cyan"},examples:[10,30,"1,10,20,40"]},{name:"quality",type:"number",defaultVal:"80",desc:"The image quality of the resulting screenshot (JPEG/WebP only)",range:"0-100",defaultOptions:{url:"spotify.com",format:"jpeg"},examples:[40,80,100]},{name:"transparent",type:"boolean",defaultVal:"false",desc:"If a website has no background color set, the image will have a transparent background (PNG/WebP only)"},{name:"max_height",type:"number",defaultOptions:{url:"urlbox.com"},examples:[{title:"Short Website",options:{max_height:2098,full_page:!0}}],desc:"For extremely lengthy websites, it may be preferable to limit the screenshot to a maximum height to prevent Urlbox from spending time scrolling and generating an enormous screenshot."},{name:"download",type:"string",desc:"Pass in a filename which sets the content-disposition header on the response. E.g. `download=myfilename.png` This will make the Urlbox link downloadable, and will prompt the user to save the file as `myfilename.png`",defaultOptions:{url:"apple.com"},examples:[{title:"With a filename",options:{download:"apple.png"}}]}]},{desc:"Options relating to PDF document generation.",heading:"PDF Options",options:[{name:"pdf_page_size",type:"enum",desc:"Sets the PDF page size. \n\n Setting this option will take precedence over `pdf_page_width` and `pdf_page_height`.",defaultVal:"A4",enums:["A0","A1","A2","A3","A4","A5","A6","Legal","Letter","Ledger","Tabloid"],defaultOptions:{format:"pdf",url:"example.com"},examples:["A0","A4","Letter"]},{name:"pdf_page_range",type:"string",desc:"Sets the PDF page range to return. \n\n By default, the page is split into a multi page document and returns all page. Use this option to restrict which pages should be returned.",defaultOptions:{format:"pdf",url:"urlbox.com"},examples:[{title:"Just the first page",options:{pdf_page_range:"1"}},{title:"The first 2 pages and the 4th page",options:{pdf_page_range:"1-2,4"}},{title:"Just the 4th page",options:{pdf_page_range:"4"}}]},{name:"pdf_page_width",type:"number",desc:"Sets the PDF page width, in pixels.",defaultOptions:{url:"urlbox.com",format:"pdf"},examples:[400,800,1400]},{name:"pdf_page_height",type:"number",desc:"Sets the PDF page height, in pixels.",defaultOptions:{url:"urlbox.com",format:"pdf"},examples:[400,800,2e3]},{name:"pdf_margin",type:"enum",desc:"Sets the margin of the PDF document.",defaultVal:"none",enums:["none","default","minimum"],defaultOptions:{url:"example.com",format:"pdf"},examples:["none","default","minimum"]},{name:"pdf_margin_top",type:"number",desc:"Sets a custom top margin on the PDF.",defaultOptions:{url:"example.com",format:"pdf"},examples:[40]},{name:"pdf_margin_right",type:"number",desc:"Sets a custom right margin on the PDF.",defaultOptions:{url:"example.com",format:"pdf"},examples:[100]},{name:"pdf_margin_bottom",type:"number",desc:"Sets a custom bottom margin on the PDF.",defaultOptions:{url:"example.com",format:"pdf"},examples:[50]},{name:"pdf_margin_left",type:"number",desc:"Set a custom left margin on the PDF.",defaultOptions:{url:"example.com",format:"pdf"},examples:[60]},{name:"pdf_auto_crop",desc:"Automatically remove white space from PDF. Occasionally a PDF will have a lot of trailing white space at the bottom of the page. This option will attempt to automatically crop the PDF to remove this white space.",type:"boolean"},{name:"pdf_scale",type:"number",desc:"Sets the scale factor of the website content in the PDF. Valid values are numbers between 0.1 and 2.",defaultVal:"1",range:"0.1 - 2",defaultOptions:{url:"example.com",format:"pdf"},examples:[.2,1.2,2]},{name:"pdf_orientation",type:"enum",desc:"Sets the orientation of the PDF.",defaultVal:"portrait",enums:["portrait","landscape"],defaultOptions:{url:"example.com",format:"pdf"},examples:["portrait","landscape"]},{name:"pdf_background",type:"boolean",desc:"Sets whether to print background images in the PDF",defaultVal:"true",defaultOptions:{url:"bbc.com",format:"pdf"},examples:[!0,!1]},{name:"disable_ligatures",desc:"Prevents ligatures from being used. Useful when rendering a PDF, and you want to extract text which contains ligatures.",type:"boolean",defaultOptions:{url:"https://kubla.fi/yhteystiedot/",format:"pdf"}},{name:"media",type:"enum",desc:"By default, when generating a PDF, the `print` CSS media query is used. To generate a PDF using the `screen` CSS, set this option to `screen`.\n\nWhen generating an image, the `screen` CSS media query is used by default. To generate an image using the `print` CSS, set this option to `print`.",defaultOptions:{url:"https://theconversation.com/wildfires-dont-just-burn-farmland-they-can-contaminate-the-water-farmers-use-to-irrigate-crops-and-support-livestock-236545",format:"pdf"},examples:[{title:"PDF using screen CSS",options:{media:"screen"}},{title:"PDF using print CSS",options:{media:"print"}},{title:"PNG using screen CSS",options:{media:"screen",format:"png"}},{title:"PNG using print CSS",options:{media:"print",format:"png"}}]},{name:"pdf_show_header",desc:"Whether to show the default pdf header on each page of the pdf. The template of the header can be changed by setting the [`pdf_header`](#pdf_header) option.",type:"boolean",defaultOptions:{url:"example.com",format:"pdf"},examples:[!0]},{name:"pdf_header",type:"string",desc:"Change the default pdf header that is shown on each page of the pdf when [`pdf_show_header`](#pdf_show_header) option is set.\n\n            You have the option to show the following variables in the header (or footer) of the pdf:\n\n            * current `date`\n            * `title` of the page\n            * `url` of the page\n            * current `pageNumber`\n            * the `totalPages` in the pdf document\n\n            You can display these variables by creating empty divs or spans, with special css class names relating to the variable you want to show.\n\n            For example, if you want to show the `date` followed by the `url`, you could use the following pdf header template:\n\n            `<div class=\"date\"></div><div class=\"url\"></div>`.\n\n            The pdf header template you set are inserted as the innerHTML of a parent div which is a flex container, and has `align-items` set to `flex-start`.\n\n            There are also some helper classes for aligning the divs or spans. The following classes are available:\n\n            * `left` - adds some left padding to the element and sets `flex: none`.\n            * `center` - aligns the element and text to the center.\n            * `right` - adds some right padding to the element and sets `flex: none`.\n            * `text` - sets the text to 8pt.\n            * `grow` - sets `flex: auto` on the element, allowing it to grow to fill the available space.\n\n\n            The default pdf header is:\n\n            `<div class='date text left'></div><div class='title text center'></div>`.\n\n            You can see exactly how the pdf page is constructed by looking at the [chromium pdf template](https://source.chromium.org/chromium/chromium/src/+/main:components/printing/resources/print_header_footer_template_page.html;l=98-100?q=header_footer%20&ss=chromium%2Fchromium%2Fsrc) in the chromium source repository.\n            ",defaultOptions:{url:"urlbox.com",format:"pdf",pdf_show_header:!0},examples:[{title:"Showing the date and url in the pdf header",options:{pdf_header:"<div class='date text left'></div><div class='url text right'></div>"}},{title:"Showing the current page and total pages in the pdf header",options:{pdf_header:"<div class='' style='color:red;margin-right:2px;'>This is page</div><div class='pageNumber text'></div><div class='text' style='color:red;margin-right:2px;margin-left:2px;'> of </div><div class='totalPages text'></div>"}}]},{name:"pdf_show_footer",desc:"Whether to show the default pdf footer on each page of the pdf. The template of the footer can be changed by setting the [`pdf_footer`](#pdf_footer) option.",type:"boolean",defaultOptions:{url:"example.com",format:"pdf"},examples:[!0]},{name:"pdf_footer",type:"string",desc:"Change the default pdf footer that is shown on each page of the pdf when [`pdf_show_footer`](#pdf_show_footer) option is set.\n\n            You have the option to show the following variables in the footer (or header) of the pdf:\n\n            * current `date`\n            * `title` of the page\n            * `url` of the page\n            * current `pageNumber`\n            * the `totalPages` in the pdf document\n\n            You can display these variables by creating empty divs or spans, with special css class names relating to the variable you want to show.\n\n            For example, if you want to show the `date` followed by the `url`, you could use the following pdf footer template:\n\n            `<div class=\"date\"></div><div class=\"url\"></div>`.\n\n            The pdf footer template you set are inserted as the innerHTML of a parent div which is a flex container, and has `align-items` set to `flex-end`.\n\n            There are also some helper classes for aligning the divs or spans. The following classes are available:\n\n            * `left` - adds some left padding to the element and sets `flex: none`.\n            * `center` - aligns the element and text to the center.\n            * `right` - adds some right padding to the element and sets `flex: none`.\n            * `text` - sets the text to 8pt.\n            * `grow` - sets `flex: auto` on the element, allowing it to grow to fill the available space.\n\n\n            The default pdf footer is:\n\n            `<div class='url text left grow'></div><div class='text right'><span class='pageNumber'></span>/<span class='totalPages'></span></div>`.\n\n            You can see exactly how the pdf page is constructed by looking at the [chromium pdf template](https://source.chromium.org/chromium/chromium/src/+/main:components/printing/resources/print_header_footer_template_page.html;l=101-105?q=header_footer%20&ss=chromium%2Fchromium%2Fsrc) in the chromium source repository.\n            ",defaultOptions:{url:"urlbox.com",format:"pdf",pdf_show_footer:!0},examples:[{title:"Showing the date and url in the pdf footer.",options:{pdf_footer:"<div class='date text left'></div><div class='url text right'></div>"}},{title:"Showing the current page and total pages in the pdf footer.",options:{pdf_footer:"<div class='' style='color:red;margin-right:2px;'>This is page</div><div class='pageNumber text'></div><div class='text' style='color:red;margin-right:2px;margin-left:2px;'> of </div><div class='totalPages text'></div>"}}]},{name:"readable",desc:"Make the pdf into a readable document by removing unnecessary elements such as navigation bars, ads, etc.",type:"boolean",defaultOptions:{url:"https://www.bloomberg.com/news/articles/2023-11-21/altman-openai-board-open-talks-to-negotiate-his-possible-return?embedded-checkout=true",format:"pdf"},examples:[!0]},{name:"pdf_title",type:"string",desc:"Sets the title metadata field of the PDF document. This is visible in PDF readers under document properties. If not set, the page's `<title>` tag will be used as the PDF title."},{name:"pdf_subject",type:"string",desc:"Sets the subject metadata field of the PDF document. This is visible in PDF readers under document properties."},{name:"pdf_author",type:"string",desc:"Sets the author metadata field of the PDF document. This is visible in PDF readers under document properties."},{name:"pdf_keywords",type:"string",desc:'Sets the keywords metadata field of the PDF document. Pass a comma-separated list of keywords, e.g. `"pdf_keywords": "screenshot,web,api"`. This is visible in PDF readers under document properties and can help with document organization and search.'},{name:"pdf_creator",type:"string",desc:"Sets the creator metadata field of the PDF document. This typically indicates the application that created the original content. Visible in PDF readers under document properties."}]},{desc:"Options to control how Urlbox caches your screenshots or PDF's. Please note that caching only applies to requests from render links. POST requests to the API are not cached.",heading:"Cache Options",options:[{name:"force",type:"boolean",defaultVal:"false",desc:"Generate a fresh render on each request, instead of getting a cached version.",defaultOptions:{url:"urlbox.com"}},{name:"unique",type:"string",desc:"Pass a unique string such as a UUID, hash or timestamp, to have more control over when to generate a fresh screenshot or PDF."},{name:"ttl",type:"number",defaultVal:2592e3,desc:"The duration to keep a screenshot or PDF in the cache, in seconds. ttl stands for 'time to live'. The default value is also the maximum value: `2592000` seconds (30 days).",defaultOptions:{url:"nytimes.com"},examples:[{value:86400,title:"1 day",onlyShowRenderLinkExampleCode:!0},{value:604800,title:"1 week",onlyShowRenderLinkExampleCode:!0},{value:2592e3,title:"1 month",onlyShowRenderLinkExampleCode:!0}]}]},{desc:"Options to configure the browser, before navigating to the URL",heading:"Request Options",options:[{name:"proxy",plan:"ultra",type:"string",desc:"Pass in a proxy server address to make screenshot requests via that server in the format `[address]:[port]`.\n\n If proxy authentication is required, you can use the following format: `[user]:[password]@[address]:[port]`."},{name:"use_proxy",plan:"ultra",type:"string",desc:"This uses the proxy you have stored on your [`project`]( /dashboard/projects ) in use to make screenshot requests via that server."},{name:"header",type:"string[]",plan:"hifi",desc:"Set a header on the request when loading the URL\n\nExample: To set the header with key `X-My-Header` to the value `SomeValue`, you would pass `header=X-My-Header%3DSomeValue`.\n      \n\nThis can be set multiple times, to set more than one header - e.g. `header=X-My-Header%3DSomeValue&header=X-My-Other-Header%3DSomeOtherValue`.\n\n      As with all options passed via the query string, the header value must be URL encoded - so `X-My-Header=SomeValue` becomes `X-My-Header%3DSomeValue` in order to be interpreted correctly by Urlbox.",defaultOptions:{url:"test-site.urlbox.com/headers",full_page:!0,block_ads:!0},examples:["X-My-Header=MyHeaderValue",{title:"Setting multiple headers",options:{header:["X-Header-1=valueOfHeader1","X-Header-2=valueOfHeader2"]}}]},{name:"cookie",type:"string[]",desc:'Sets a cookie on the request when loading the URL.\n\n              Example: To set the cookie with key `Opt-In` to the value `yes`, you would set the value of this option to `Opt-In=yes`.\n\n              Cookies can be passed as an array, to allow setting multiple cookies - e.g.`["Opt-In=yes","Session-Id=DMTIzNDU"]`.\n\n                To achieve multiple cookies with render links, just set the cookie option multiple times, like `cookie=Opt-In%3Dyes&cookie=Session-Id%3DDMTIzNDU`.\n\n                To set a specific domain on a cookie, you can do the following: `OptIn=yes;Domain=.mydomain.com`.\n\n                You can set other attributes for the cookie such as `Path`, `HttpOnly` and `SameSite`',defaultOptions:{url:"test-site.urlbox.com/cookies",full_page:!0,block_ads:!0},examples:["OptIn=yes",{title:"Setting multiple cookies",options:{cookie:["OptIn=yes","BestScreenshots=urlbox",`SomeComplexJson={"user":{"id": 123,"name": "Alice","preferences": {  "notifications": true,  "theme": "dark"},"address": null,"quote": "She said, "It's a beautiful day!"","complex_key": "Value with a space","large_number": 12345678901234567890,"mixed_array": [true, 123, "text", null, { "nested": "object" }]},"is_active": "true",  // My comment"special_characters": "This string has a backslash: \\ and a newline:
"}`]}},{title:"Setting specific domain and other attributes for a cookie",options:{cookie:["SomeCookie=value;Domain=.mydomain.com;Path=/somepath;SameSite=Lax;","BestScreenshots=urlbox;"]}}]},{name:"user_agent",type:"string",desc:`Sets the \`User-Agent\` string for the request. The user agent identifies what browser/device is making the request, which can affect how websites render content.

**Presets:**
* \`random\` - Uses a random user-agent to help avoid bot detection
* \`mobile\` - Uses a modern iPhone/Safari user-agent string
* \`desktop\` - Uses a modern Chrome/macOS user-agent string

**Why use this?**
- Some websites serve different content based on the user agent (e.g., mobile vs desktop layouts)
- Certain sites block requests from unknown or bot-like user agents
- You may want to emulate how a specific browser or crawler sees a page

**Testing your user agent:**
Try rendering [httpbin.org/user-agent](https://httpbin.org/user-agent) to see exactly what user agent string is being sent.

For a comprehensive list of user agent strings, see [useragents.me](https://www.useragents.me/).`,defaultOptions:{url:"httpbin.org/user-agent",block_ads:!0,fail_on_4xx:!0},examples:["random","mobile","desktop",{value:"Googlebot/2.1 (+http://www.google.com/bot.html)",title:"Google bot"},{value:"facebookexternalhit/1.1",title:"Facebook crawler"},{value:"Mozilla/5.0 (Macintosh; Intel Mac OS X 11_2_3) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/89.0.4389.90 Safari/537.36",title:"Custom"}]},{name:"platform",type:"string",desc:"Sets the `navigator.platform` that the browser will report for the request. Useful for getting around certain scripts that detect the platform.",defaultVal:"MacIntel",defaultOptions:{url:"test-site.urlbox.com/user-agent",engine_version:"latest",fail_on_4xx:!0},examples:["MacIntel","Linux x86_64","Linux armv81","Win32"]},{name:"accept_lang",type:"string",defaultVal:"en-US",desc:"Sets an `Accept-Language` header on requests to the target URL",defaultOptions:{url:"test-site.urlbox.com/user-agent",full_page:!0,block_ads:!0,fail_on_4xx:!0},examples:["de-CH","ko-KR"]},{name:"authorization",type:"string",desc:"Sets an `Authorization` header on requests to the target URL.\n Can be used to pass an auth token through to the site in order to 'login' before rendering.",defaultOptions:{url:"test-site.urlbox.com/headers",full_page:!0,block_ads:!0},examples:["Basic my_base64_auth_token","Bearer my_bearer_token"]},{name:"tz",type:"string",defaultVal:"UTC",desc:"Emulate the timezone to use when rendering pages.\n\n Example: `tz=Europe/London`. A list of timezone ID's can be found here: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones",defaultOptions:{url:"test-site.urlbox.com/time-zone",fail_on_4xx:!0},examples:["Asia/Kolkata","Asia/Tokyo","America/Sao_Paulo","Europe/London"]},{name:"engine_version",type:"enum",defaultOptions:{url:"urlbox.com"},enums:["stable","latest","experimental"],desc:"Sets the version of the urlbox rendering engine to use when rendering the page. This can be useful for testing how a page will render in the latest version of our rendering engine."},{name:"certify",plan:"ultra",type:"boolean",desc:"This creates a hash of the rendered file, timestamp and options providing proof that a render was taken at a given time. Returns a hash, timestamp and the options used to hash. Checkout our [`guide`]( /guides/certify-a-screenshot ) on certifying a render for more information."}]},{desc:"Options to control how Urlbox waits for the page or elements to load before rendering.",heading:"Wait Options",options:[{name:"delay",type:"number",defaultVal:"0",desc:"The amount of time to wait before Urlbox captures a render in milliseconds."},{name:"timeout",type:"number",defaultVal:"30000",desc:"The amount of time to wait for the requested URL to load, in milliseconds. The timeout value needs to be between 5,000 and 100,000 milliseconds. The default is 30000 or 30 seconds."},{name:"wait_until",type:"enum",desc:"Waits until the specified DOM event has fired before capturing a render.\n\nThe available options are:\n\n* `domloaded` (the `DOMContentLoaded` event is fired)\n* `mostrequestsfinished` (consider navigation to be finished when there are no more than 2 network connections for at least 500 ms)\n* `requestsfinished` (there are no more than 0 network connections for at least 500 ms)\n* `loaded` (the `load` event is fired) ",defaultVal:"loaded",defaultOptions:{url:"example.com"},enums:["domloaded","mostrequestsfinished","requestsfinished","loaded"],examples:["domloaded","mostrequestsfinished","requestsfinished","loaded"]},{name:"wait_for",type:"string",desc:"Waits for the element specified by this selector to be present in the DOM before taking a screenshot or PDF. \n\nBy default, Urlbox will take a screenshot or PDF if the `wait_for` element is not found after waiting for the time specified by the [`wait_timeout`](#wait_timeout) option.\n\n If you prefer Urlbox to fail the request when the `wait_for` element is not found, pass [`fail_if_selector_missing=true`](#fail_if_selector_missing)",defaultOptions:{url:"test-site.urlbox.com/loads_in/10/seconds"},examples:[{value:"",title:"Without wait_for"},"#loaded_element"]},{name:"wait_for_state",type:"enum",desc:"Whether the element specified by wait_for should be visible or just present in the DOM. Visible means the element is attached to the DOM and has opacity > 0 and its width and height > 0 and doesn't have `visibility:hidden` set.",defaultOptions:{url:"test-site.urlbox.com/loads_in/10/seconds"},enums:["visible","attached"],defaultVal:"attached"},{name:"wait_to_leave",type:"string",desc:"Waits for the element specified by this selector to be absent from the DOM before taking a screenshot or PDF. \n\nA typical use-case would be waiting for loading spinners to be absent before taking a screenshot. \n\nBy default, Urlbox will take a screenshot or PDF if the `wait_to_leave` element is still present after the time specified by the [`wait_timeout`](#wait_timeout) option. \n\n If you prefer Urlbox to fail the request when the `wait_to_leave` element is still present, pass [`fail_if_selector_present=true`](#fail_if_selector_present)",defaultOptions:{url:"test-site.urlbox.com/loads_in/10/seconds"},examples:[{value:"",title:"Without wait_to_leave"},"#loading_element"]},{name:"wait_timeout",type:"number",desc:"The amount of time to wait for the [`wait_for`](#wait_for) element to appear, or the [`wait_to_leave`](#wait_to_leave) element to leave before continuing, in milliseconds.",defaultVal:3e4}]},{desc:"Options to dictate how Urlbox handles certain scenarios.",heading:"Fail Options",options:[{name:"fail_if_selector_missing",type:"boolean",desc:"Fails the request if the elements specified by `selector` or `wait_for` options are not found on the page after waiting for `wait_timeout`.",defaultVal:"false"},{name:"fail_if_selector_present",type:"boolean",desc:"Fails the request if the element specified by `wait_to_leave` option is found on the page after waiting for `wait_timeout`.",defaultVal:"false"},{name:"fail_on",type:"string | string[]",desc:'Pass in a specific HTTP status code (e.g., `"400"`, `"500"`) or an array of status codes (e.g., `["400", "404", "500"]`) as strings. Urlbox will fail the request if the final response status code matches any of the specified codes.'},{name:"fail_on_4xx",type:"boolean",desc:"If `fail_on_4xx=true` and the requested URL returns a status code between 400 and 499, Urlbox will fail the request with error code 400 and the message: `Failed to render. Requested URL returned a 4xx error code and fail_on_4xx was true`",defaultVal:"false",defaultOptions:{url:"test-site.urlbox.com/status/404"},examples:[!1,!0]},{name:"fail_on_5xx",type:"boolean",desc:"If `fail_on_5xx=true` and the requested URL returns a status code between 500 and 599, Urlbox will fail the request with error code 400 and message: `Failed to render. Requested URL returned a 5xx error code and fail_on_5xx was true`",defaultVal:"false",defaultOptions:{url:"test-site.urlbox.com/status/500"},examples:[!1,!0]},{name:"fail_on_except",type:"string | string[]",desc:"Specify status codes to exclude from [`fail_on`](#fail_on), [`fail_on_4xx`](#fail_on_4xx), or [`fail_on_5xx`](#fail_on_5xx) checks. For example, if you want to fail on all 5xx errors except 503, use `fail_on_5xx=true` with `fail_on_except=503`."},{name:"retry_on",type:"string | string[]",plan:"ultra",desc:'Automatically retry renders when specific conditions occur. Pass a single condition, a comma-separated string, or an array of conditions.\n\nWhen a condition matches, Urlbox will retry with exponential backoff (delay doubles each time, starting at 1 second by default) up to 3 times by default.\n\n**HTTP status conditions** (retry based on the page\'s response):\n\n- **`4xx`** - Retry when the page returns any 4xx status\n- **`5xx`** - Retry when the page returns any 5xx status\n- **`404`**, **`429`**, **`503`**, etc. - Retry on specific status codes\n\n**Engine conditions** (retry when Urlbox encounters an internal error):\n\n- **`timeout`** - Retry when the render times out\n- **`crash`** - Retry when the browser crashes\n\n**Quality conditions:**\n\n- **`small_size`** - Retry when the screenshot is smaller than [`min_size_bytes`](#min_size_bytes)\n\n**Special values:**\n\n- **`all`** - Retry on any of the conditions above\n\n**Examples:**\n\n- `retry_on: "4xx"` - Retry when the page returns any 4xx status\n- `retry_on: ["429", "503"]` - Retry on rate limiting or service unavailable\n- `retry_on: "timeout,crash"` - Retry on engine failures only\n- `retry_on: "5xx,timeout"` - Retry on page 5xx errors or timeouts\n\n**Note:** If a condition matches both `retry_on` and [`fail_on`](#fail_on), the request will be retried first. Use [`fail_on_except`](#fail_on_except) to mark specific status codes as acceptable (won\'t retry or fail).'},{name:"max_retries",type:"number",plan:"ultra",desc:"Maximum number of retry attempts when using [`retry_on`](#retry_on). Must be between 0 and 5.",defaultVal:"3"},{name:"retry_delay_ms",type:"number",plan:"ultra",desc:"Base delay in milliseconds between retry attempts. The delay doubles with each retry (exponential backoff). Must be between 100 and 60000.",defaultVal:"1000"},{name:"min_size_bytes",type:"number",plan:"ultra",desc:'Minimum expected file size in bytes. Used with [`retry_on: "small_size"`](#retry_on) to retry when the screenshot is smaller than expected, which may indicate an error page was captured instead of the intended content.',defaultVal:"1000"}]},{desc:"Options to modify the page state before taking a screenshot or PDF",heading:"Page Options",options:[{name:"scroll_to",type:"string | number",desc:"Scroll, to either an element or to a pixel offset from the top, before taking a screenshot",defaultOptions:{url:"urlbox.com"},examples:["#playground",1024,5e3]},{name:"click",type:"string",desc:'Specifies an element selector to click before generating a screenshot or PDF\n\nExample: `#clickme` would click an element with `id="clickme"`. \n\n Can be used multiple times to simulate multiple sequential click events.\n\n If the selector matches multiple elements, only the first element will be clicked.',defaultOptions:{url:"https://www.wikipedia.org/"},examples:[{title:"Minimizing the overlay",options:{click:"#overlay-banner-toggle"}},{title:"Without minimizing the overlay",options:{}}]},{name:"click_all",type:"string[]",desc:'Specifies an element selector to click before generating a screenshot or PDF\n\nExample: `.clickme` would click all elements with `class="clickme"`. \n\n Can be used multiple times to simulate multiple sequential click events.\n\n If the selector matches multiple elements, all elements will be clicked.',defaultOptions:{url:"https://www.npmjs.com/"},examples:[{title:"Navigate to a Sign-up page, and agree to policies.",options:{click_all:["#signup","#signup_eula-agreement"]}}]},{name:"hover",type:"string",desc:'Specifies an element selector to hover over before generating a screenshot or PDF\n\nExample: `#hoverme` would hover over the element with `id="hoverme"`',defaultOptions:{url:"https://rubyonrails.org/"},examples:[{title:"Hovering over the ruby-on-rails logo",options:{hover:".nav__logo"}},{title:"Without hovering over the ruby-on-rails logo",options:{}}]},{name:"bg_color",type:"string",desc:"Specify a hex code or CSS color string to use as the background color\n\nSome websites don't set a body background colour, and will show up as transparent backgrounds with PNG, or black when using JPG. Use this setting to set a background colour. If the website explicitly sets a transparent background on the html or body elements, this setting will be overridden."},{name:"disable_js",type:"boolean",defaultVal:"false",desc:"Turns off javascript on the target URL. \n\n~> Enabling this option will prevent `full_page=true` and many other options, because having javascript disabled prevents Urlbox from evaluating code inside the page's context.",defaultOptions:{url:"nytimes.com"},examples:[!0,!1]},{name:"show_certificate_errors",type:"boolean",defaultVal:"false",desc:"Shows browser certificate errors for pages with invalid HTTPS certificates. By default, Urlbox ignores certificate errors so pages with expired, self-signed, or otherwise invalid certificates can still render."}]},{desc:"Advanced options to control how Urlbox takes full page screenshots, when `full_page=true`",heading:"Full Page Options",options:[{name:"full_page_mode",type:"enum",defaultVal:"stitch",enums:["stitch","native"],desc:"Whether to use scroll and stitch algorithm (the default) to render a full page screenshot, or to use the native full page screenshot algorithm, which is faster, but can be less accurate on some sites."},{name:"full_width",type:"boolean",defaultVal:"false",desc:"When full_page=true, specify whether to capture the full width of the website, for example if the site is horizontally scrolling."},{name:"allow_infinite",type:"boolean",defaultVal:!1,desc:"By default, when Urlbox detects an infinite scrolling page, it does not attempt to continue scrolling to the bottom, as this could result in infinite scrolling! If you want to override this behaviour, pass `true` for this option."},{name:"skip_scroll",type:"boolean",defaultVal:"false",desc:"Enabling `skip_scroll` will speed up renders by skipping an initial scroll through the page, which is used to trigger any lazy loading elements.",defaultOptions:{url:"urlbox.com",full_page:!0,skip_scroll:!0},examples:[!0,!1]},{name:"detect_full_height",type:"boolean",defaultVal:!1,desc:"Some pages have full-height backgrounds whose heights are set to 100% of the viewport. This can cause the backgrounds to get stretched when making a full page screenshot. If you are seeing this behaviour in your full page screenshots, pass `true` for this option."},{name:"max_section_height",type:"number",defaultVal:4096,desc:"When Urlbox takes a `full_page` screenshot, the maximum height of each image section is set to 4096 pixels. If a sites height is greater than this value, Urlbox will start splitting the screenshot into sections. Sometimes it is worthwhile experimenting with this number."},{name:"scroll_increment",type:"number",desc:"Sets how many pixels to scroll when scrolling the page to trigger lazy loading elements. By default, the scroll increment is set to the browser viewport height. Some pages' lazy loading elements only trigger when the scroll increment is smaller than this, however, e.g. 400px."},{name:"scroll_delay",type:"number",desc:"When Urlbox decides to split a screenshot into multiple sections, the scroll delay is the time to wait between taking the screenshots of each individual section, in milliseconds. While Urlbox does detect animations, and attempts to wait for them before taking a screenshot, this option could be used to force Urlbox to wait for a certain amount of time after scrolling to the next section, to wait for things like animations to finish."}]},{desc:"Options for highlighting a given string on the page. These are useful for either highlighting or hiding (if you use the same foreground and background) words or a given set of characters.",heading:"Highlighting Options",options:[{name:"highlight",type:"string",desc:"Specify a string to highlight on the page before capturing a screenshot or PDF. To highlight multiple words, separate words with a pipe character e.g. Hello|World",defaultOptions:{url:"urlbox.com",format:"pdf"},examples:["urlbox|api"]},{name:"highlightfg",type:"string",desc:"Specify the text color of the highlighted word.",defaultVal:"white",defaultOptions:{url:"urlbox.com",format:"pdf",highlight:"urlbox|api",highlightbg:"black"},examples:[{title:"Using color name",options:{highlightfg:"blue"}},{title:"Using rgb",options:{highlightfg:"rgb(42,160,68)"}},{title:"Using rgba",options:{highlightfg:"rgba(255,255,0,1)"}}]},{name:"highlightbg",type:"string",desc:"Specify the background color of the highlighted word.",defaultVal:"red",defaultOptions:{url:"urlbox.com",format:"pdf",highlight:"urlbox|api",highlightfg:"black"},examples:[{title:"Using color name",options:{highlightbg:"blue"}},{title:"Using rgb",options:{highlightbg:"rgb(42,160,68)"}},{title:"Using rgba",options:{highlightbg:"rgba(255,255,0,1)"}}]}]},{desc:"Options for the geolocation API.",heading:"Geolocation Options",options:[{name:"latitude",type:"number",desc:"Sets the latitude used to emulate the Geolocation API.",defaultOptions:{url:"https://www.infobyip.com/browsergeolocation.php",longitude:40.7128},examples:[74.006]},{name:"longitude",type:"number",desc:"Sets the longitude used to emulate the Geolocation API.",defaultOptions:{url:"https://www.infobyip.com/browsergeolocation.php",latitude:74.006},examples:[40.7128]},{name:"accuracy",type:"number",desc:"Sets the accurate of the Geolocation API in metres.",defaultOptions:{url:"https://www.infobyip.com/browsergeolocation.php",latitude:74.006,longitude:40.7128},examples:[100,5e3]}]},{desc:"Options related to storing the screenshots in Amazon S3.",heading:"Storage Options",options:[{name:"use_s3",desc:"Save the render directly to the S3 (or S3-Compatible) bucket configured on your account.",type:"boolean",plan:"hifi",defaultVal:"false"},{name:"s3_path",desc:"Sets the S3 path, including subdirectories and the filename, to use when saving the render in your S3-compatible bucket.\n\n~> The extension (e.g. .png, .jpg or .pdf) will be provided automatically, and should not be included in `s3_path`.",plan:"hifi",type:"string"},{name:"no_suffix",plan:"hifi",desc:"By default, urlbox adds the file extension (e.g. `.png`, `.jpg`, `.pdf` etc) to the `s3_path`.\n\nIf `no_suffix=true`, the file extension will NOT be added to the `s3_path`.",type:"boolean"},{name:"s3_bucket",desc:"Overrides the configured bucket to use when saving the render.",plan:"hifi",defaultOptions:{url:"apple.com"},type:"string"},{name:"s3_endpoint",desc:"You can change the endpoint URL to use an S3 compatible storage provider e.g. DigitalOcean Spaces, Minio, Wasabi, Cloudflare R2 and more.",plan:"hifi",type:"string"},{name:"s3_region",desc:"Override the configured S3 region when saving the render.",plan:"hifi",type:"string"},{name:"cdn_host",desc:"If your custom bucket is fronted by a CDN, you can set the host name here.",plan:"hifi",type:"string"},{name:"s3_storageclass",desc:"Sets the s3 storage class.",plan:"hifi",type:"enum",enums:["standard","standard_ia","reduced_redundancy","onezone_ia","intelligent_tiering","glacier","deep_archive","outposts"],defaultVal:"standard"}]},{desc:"Options related to LLM usage.",heading:"LLM Options",options:[{name:"use_llm",plan:"ultra",type:"boolean",desc:"Use the LLM configuration setup in your project settings, or those passed into the request."},{name:"llm_prompt",plan:"ultra",type:"string",desc:'The prompt to give the LLM EG "Analyse this image and its associated HTML, giving me back a summary of what the website contents are and a list of all of the links it has "'},{name:"llm_system_prompt",plan:"ultra",type:"string",desc:"This can be used to provide more overall context for the AI's response."},{name:"llm_key",plan:"ultra",type:"string",desc:"The API access key for the given LLM provider."},{name:"llm_provider",plan:"ultra",type:"string",desc:"The LLM provider to use.",enums:["anthropic","openai","google","azure","mistral","cohere","amazon-bedrock","google-vertex","groq","xai","deepseek","perplexity","togetherai","fireworks","cerebras","openrouter"]},{name:"llm_model",plan:"ultra",type:"string",desc:"The LLM model to use for the given provider. E.g. 'gpt-5.1' for OpenAI, 'claude-sonnet-4-5-20250929' for Anthropic."},{name:"llm_temperature",plan:"ultra",type:"number",desc:"The temperature (creativity) for the LLM prompt. Defaults to 0 for less creative responses."},{name:"llm_max_tokens",plan:"ultra",type:"number",desc:"The max number of output tokens the LLM can generate a response with. Defaults to 1000."},{name:"llm_height",plan:"ultra",type:"number",desc:"The height of the thumbnail image that is sent to the LLM. Defaults to 512."},{name:"llm_width",plan:"ultra",type:"number",desc:"The width of the thumbnail image that is sent to the LLM. Defaults to 512."},{name:"llm_base_url",plan:"ultra",type:"string",desc:"Override the default API endpoint for the LLM provider. Useful for proxies, self-hosted models, or custom endpoints."},{name:"llm_azure_resource_name",type:"string",desc:"Azure OpenAI resource name. Used to construct the endpoint URL: `https://{resourceName}.openai.azure.com/`"},{name:"llm_azure_api_version",type:"string",desc:"Azure OpenAI API version. Required when using deployment URLs. E.g. '2024-02-15-preview'."},{name:"llm_azure_use_deployment_urls",type:"boolean",desc:"Use legacy Azure deployment URL format. Useful for compatibility with certain Azure OpenAI models or deployments that require the legacy endpoint format."},{name:"llm_aws_region",type:"string",desc:"AWS region for Amazon Bedrock. Defaults to 'us-east-1'."},{name:"llm_aws_access_key_id",type:"string",desc:"AWS access key ID for Amazon Bedrock authentication."},{name:"llm_aws_secret_access_key",type:"string",desc:"AWS secret access key for Amazon Bedrock authentication."},{name:"llm_aws_session_token",type:"string",desc:"Optional AWS session token for temporary credentials with Amazon Bedrock."},{name:"llm_gcp_project",type:"string",desc:"Google Cloud project ID for Google Vertex AI."},{name:"llm_gcp_location",type:"string",desc:"Google Cloud region for Vertex AI. Defaults to 'us-central1'."},{name:"llm_gcp_service_account_json",type:"string",desc:"Google Cloud service account JSON key for Vertex AI authentication. Pass the entire JSON key file contents as a string."},{name:"llm_full_response",plan:"ultra",type:"boolean",desc:"Return the full LLM response including usage statistics and metadata, rather than just the text content."},{name:"llm_output",plan:"ultra",type:"string",enums:[...__turbopack_context__.i(698332).LLMStructuredOutputs],desc:"You can provide a structured output type and schema to Urlbox, and we will prompt your LLM to give back that response structure. By passing an llm_schema without this option, it will default to responding with an object specified by your JSON Schema. If you choose Array, the response will be an array of your provided JSON Schema. If you choose enum, you can provide an array of strings as your schema, and your LLM will respond only with a value from that enum."},{name:"llm_schema",plan:"ultra",type:"JSON",examples:[{title:"Screenshot of urlbox.com",options:{url:"urlbox.com",use_llm:!0,llm_prompt:"Please analyse this image, respecting the structured output provided.",llm_output:"object",llm_schema:{type:"object",properties:{url:{type:"string",format:"uri",description:"The original URL of the webpage"},title:{type:"string",description:"The title of the webpage"},description:{type:"string",description:"A short summary of what is visible in the screenshot"}},required:["url","title","description"]}}},{title:"Screenshot of urlbox.com",options:{url:"urlbox.com",use_llm:!0,llm_prompt:"Please analyse this image, respecting the structured output provided.",llm_output:"array",llm_schema:{type:"object",properties:{url:{type:"string",format:"uri",description:"The original URL of the webpage"},title:{type:"string",description:"The title of the webpage"},description:{type:"string",description:"A short summary of what is visible in the screenshot"}},required:["url","title","description"]}}},{title:"Screenshot of urlbox.com",options:{url:"urlbox.com",use_llm:!0,llm_prompt:"Analyse this website screenshot, and tell me what category of site it is based on my structured output schema.",llm_output:"enum",llm_schema:["website","blog","ecommerce","documentation","social","news"]}}],desc:"This is the JSON schema or string[] provided which we will pass over to your LLM. Your LLM provider will respond with a structured output (if supported by your provider) according to that schema. Please take a look at the various resources on the [JSON Schema](https://json-schema.org/tools?query=&sortBy=name&sortOrder=ascending&groupBy=toolingTypes&licenses=&languages=&drafts=&toolingTypes=&environments=&showObsolete=false&supportsBowtie=false) website for more information on designing and validating a JSON schema."}]}];__turbopack_context__.s(["getOptionsObject",0,()=>{let object={};for(let group of options)for(let option of group.options)object={...object,[option.name]:option};return object},"options",0,options])}]);